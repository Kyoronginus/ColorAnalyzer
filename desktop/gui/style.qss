/* style.qss - Pixiv Sketch風 丸っこくてやさしいダークUI */

QWidget {
    background-color: #181818;
    color: #e8e8e8;
    font-family: "Segoe UI", "Roboto", sans-serif;
    font-size: 14px;
}

QLabel {
    color: #f0f0f0;
    padding: 4px;
    font-weight: 500;
}

QPushButton {
    background-color: #242424;
    border: none;
    border-radius: 10px;
    padding: 8px 16px;
    color: #ffffff;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #2f2f2f;
}

QPushButton:pressed {
    background-color: #3a3a3a;
}

QTextEdit {
    background-color: #1f1f1f;
    border: 1px solid #333;
    border-radius: 10px;
    padding: 8px;
    color: #ffffff;
}

QScrollArea {
    background-color: #181818;
    border: none;
}

QFileDialog, QLineEdit {
    background-color: #1f1f1f;
    color: #ffffff;
    border: 1px solid #333;
    border-radius: 8px;
    padding: 6px;
}
